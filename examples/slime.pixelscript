# Bouncing slime, 16x16, 4 frames.
#   node pixelart.js build examples/slime.pixelscript
canvas 16 16
palette add o #1b2a1f
palette ramp #5ccf5c abcd
palette add w #ffffff
palette add k #101820
palette add s #000000

# --- frame 0: rest pose -------------------------------------------------
frame 0
ellipse 2 6 12 9 b
ellipse 3 6 10 6 c
ellipse 4 7 5 3 d
ring 2 6 12 9 o
outline o
rect 5 9 2 3 w
rect 9 9 2 3 w
rect 6 10 1 2 k
rect 10 10 1 2 k
px 5 8 d
px 9 8 d
# shadow
rect 3 15 10 1 s

# --- frame 1: squash ----------------------------------------------------
frames 4 copy
frame 1
clear
ellipse 1 8 14 7 b
ellipse 2 8 12 4 c
ellipse 3 9 5 2 d
ring 1 8 14 7 o
outline o
rect 4 10 2 2 w
rect 10 10 2 2 w
rect 5 10 1 2 k
rect 11 10 1 2 k
rect 2 15 12 1 s

# --- frame 2: stretch (in the air) ---------------------------------------
frame 2
clear
ellipse 4 1 8 12 b
ellipse 5 1 6 8 c
ellipse 6 2 3 3 d
ring 4 1 8 12 o
outline o
rect 5 5 2 3 w
rect 9 5 2 3 w
rect 6 6 1 2 k
rect 10 6 1 2 k
rect 6 15 4 1 s

# --- frame 3: land ------------------------------------------------------
frame 3
clear
ellipse 1 8 14 7 b
ellipse 2 8 12 4 c
ellipse 3 9 5 2 d
ring 1 8 14 7 o
outline o
rect 4 10 2 2 w
rect 10 10 2 2 w
rect 5 11 1 1 k
rect 11 11 1 1 k
rect 2 15 12 1 s

frame dur all 120
frame dur 2 80
