# Dependencies (restore with: npm install)
node_modules/

# Generated art: work folders (output/<name>/: script, document, previews) and finished exports
# (final-output/) made with the tool.
# The folders are recreated automatically. Shareable demos live in examples/.
output/
final-output/

# Personal settings written by "node pixelart.js config" (e.g. iterations)
pixelart.config.json

# Logs and npm debris
*.log
npm-debug.log*
.npm/

# Test / temporary files
*.tmp
coverage/

# Editors
.vscode/
.idea/
*.swp

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
